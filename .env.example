# =============================================================
# Vencer — Environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's gitignored.
# =============================================================

# --- Resend (REQUIRED — this is how the forms deliver leads) ---
# The contact + referral forms email each submission here via Resend.
# Get a key from resend.com → API Keys. Sign up with alain@vencer.dev so
# notifications can send to that address before the domain is verified.
RESEND_API_KEY=re_your_api_key_here

# Where new-submission notifications are sent (defaults to alain@vencer.dev)
NOTIFICATION_EMAIL=alain@vencer.dev

# Sender address for notification emails. Leave unset and emails send from
# Resend's `onboarding@resend.dev` (works immediately, no DNS setup required).
# Once you've verified vencer.dev in Resend, switch this to:
#   EMAIL_FROM=Vencer Inbox <inbox@vencer.dev>
# EMAIL_FROM=Vencer Inbox <inbox@vencer.dev>

# --- Supabase (OPTIONAL — powers the /admin inbox + stored lead history) ---
# The forms work WITHOUT these (email-only). Fill them in only when you have a
# free Supabase project slot available; submissions will then also persist to
# the `submissions` table and show up at /admin. See SETUP-ADMIN.md.
# Get from supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-public-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key-keep-secret...

# --- Admin allowlist (only needed once Supabase/the inbox is enabled) ---
# Only this email can log into /admin. Magic-link logins from any
# other address are rejected by middleware.
ADMIN_EMAIL=alain@vencer.dev

# --- PostHog (product analytics + session replay) ---
# Get from posthog.com → Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Site URL (for absolute links in email templates) ---
NEXT_PUBLIC_SITE_URL=https://vencer.dev
